{
  "name": "tree-sitter-c-sharp",
  "version": "0.23.6",
  "description": "Brokk-maintained Tree-sitter grammar for C#",
  "type": "module",
  "repository": "https://github.com/BrokkAi/tree-sitter-c-sharp",
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "maintainers": [
    {
      "name": "Brokk"
    }
  ],
  "bugs": {
    "url": "https://github.com/BrokkAi/tree-sitter-c-sharp/issues"
  },
  "homepage": "https://github.com/BrokkAi/tree-sitter-c-sharp#readme",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "c-sharp"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "8.5.0",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "eslint": "9.32.0",
    "eslint-config-treesitter": "1.0.2",
    "prebuildify": "6.0.1",
    "tree-sitter": "0.25.0",
    "tree-sitter-cli": "0.26.5"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
